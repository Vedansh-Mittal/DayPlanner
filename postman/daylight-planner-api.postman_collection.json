    {
      "name": "5. Search & RPC",
      "description": "Full-text search RPC query.",
      "item": [
        {
          "name": "Full-Text Search Across Entries",
          "request": {
            "method": "POST",
            "header": [
              { "key": "apikey", "value": "{{anonKey}}", "type": "text" },
              { "key": "Authorization", "value": "Bearer {{authToken}}", "type": "text" },
